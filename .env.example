# =============================================================================
# HH Goa 2026 Task 2 — Voice-Enabled RAG — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values marked <REQUIRED>.
# Never commit .env to version control.
# =============================================================================

# ---------------------------------------------------------------------------
# ENVIRONMENT
# ---------------------------------------------------------------------------
ENVIRONMENT=development          # "development" or "production"

# ---------------------------------------------------------------------------
# SPEECH-TO-TEXT  ·  ElevenLabs Scribe v1
# ---------------------------------------------------------------------------
# Get your key at https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=<YOUR_ELEVENLABS_API_KEY>    # REQUIRED

# ---------------------------------------------------------------------------
# ANSWER GENERATION  ·  Groq
# ---------------------------------------------------------------------------
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=<YOUR_GROQ_API_KEY>                # REQUIRED
GROQ_MODEL=llama-3.3-70b-versatile             # Default model

# ---------------------------------------------------------------------------
# VECTOR DATABASE  ·  Qdrant
# ---------------------------------------------------------------------------
# Leave both blank to use a LOCAL on-disk Qdrant (recommended for development).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=                  # Qdrant API key (leave blank for local)

# ---------------------------------------------------------------------------
# CACHE
# ---------------------------------------------------------------------------
CACHE_BACKEND=memory             # "memory" (default, no extra setup) or "redis"
REDIS_URL=                       # e.g. redis://localhost:6379/0  (only when CACHE_BACKEND=redis)

# ---------------------------------------------------------------------------
# EMBEDDING
# ---------------------------------------------------------------------------
# "real" uses sentence-transformers (download ~100 MB on first run).
# "mock" uses deterministic random vectors — useful for unit tests.
EMBEDDING_MODE=real

# ---------------------------------------------------------------------------
# CHUNKING
# ---------------------------------------------------------------------------
CHUNK_STRATEGY=semantic          # "sentence" | "semantic" | "hierarchical"
SEMANTIC_THRESHOLD=0.65

# ---------------------------------------------------------------------------
# RERANKING
# ---------------------------------------------------------------------------
RERANKER_TYPE=cosine             # "cosine" (fast, no extra download) or "cross_encoder"

# ---------------------------------------------------------------------------
# INGESTION
# ---------------------------------------------------------------------------
INGESTION_LIMIT=1000             # docs to ingest: 100-1000 (dev), 10k-100k (staging), 0 = all
ALLOW_SYNTHETIC_FALLBACK=false   # NEVER set true for benchmarks / final submission
